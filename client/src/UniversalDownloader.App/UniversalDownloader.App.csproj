<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UniversalDownloader.App</RootNamespace>
    <AssemblyName>UniversalDownloader.App</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <!-- UseWPF + UseWindowsForms change the SDK's implicit usings: System.IO and
       System.Net.Http are NOT included (CS0103/CS0246), while both
       System.Windows.Forms and Microsoft.Win32 ARE (CS0104 ambiguities).
       Fix centrally here instead of scattering usings. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalDownloader.Core\UniversalDownloader.Core.csproj" />
    <ProjectReference Include="..\UniversalDownloader.Infrastructure\UniversalDownloader.Infrastructure.csproj" />
    <ProjectReference Include="..\UniversalDownloader.Worker\UniversalDownloader.Worker.csproj" />
  </ItemGroup>

</Project>
