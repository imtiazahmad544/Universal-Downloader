<Window x:Class="UniversalDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Downloader" Height="720" Width="1120"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="8">
                <TextBlock Text="Universal Downloader" FontWeight="Bold" FontSize="15" Margin="4,8,4,16"/>
                <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}"/>
                <Button Content="Sources" Command="{Binding ShowSourcesCommand}"
                        IsEnabled="{Binding CanUseProtectedFeatures}"/>
                <Button Content="Jobs" Command="{Binding ShowJobsCommand}"
                        IsEnabled="{Binding CanUseProtectedFeatures}"/>
                <Button Content="Settings" Command="{Binding ShowSettingsCommand}"/>
                <Separator Margin="0,12"/>
                <Button Content="Log out" Command="{Binding LogoutCommand}"/>
                <TextBlock Text="{Binding AccountSummary}" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,12,4,0"/>
            </StackPanel>
        </Border>

        <!-- Current view -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
