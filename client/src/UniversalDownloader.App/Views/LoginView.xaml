<UserControl x:Class="UniversalDownloader.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="White">
        <Border Width="360" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Universal Downloader" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Sign in with your customer ID" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
                <TextBlock Text="Customer ID"/>
                <TextBox Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Password" Margin="0,8,0,0"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="4,8,4,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Log in" Click="LoginButton_Click" IsDefault="True" Margin="4,16,4,0"/>
                <ProgressBar IsIndeterminate="True" Height="6" Margin="4,8,4,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
