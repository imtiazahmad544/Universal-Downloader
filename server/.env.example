# Copy to .env and fill in real values. Never commit a real .env.

# Database (SQLite default; Postgres e.g. postgresql+psycopg2://user:pass@host/db)
DATABASE_URL=sqlite:///./universal_downloader.db

# JWT auth
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Optional Redis (worker queue, future); blank = not configured
REDIS_URL=

# Initial admin bootstrap (used by the seed workstream)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Batch / discovery tuning
BATCH_DEFAULT_SIZE=20
DISCOVERY_MAX_ITEMS=500

# Logging
LOG_LEVEL=INFO

# Provider API credentials (future integrations; placeholders)
TIKTOK_API_KEY=
TIKTOK_API_SECRET=
INSTAGRAM_API_TOKEN=

# Deployment environment: dev or prod
APP_ENV=dev

# v2.0 encrypted cookies: Fernet key (44-char base64). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank = dev-only ephemeral key (loud warning; cookies die on restart).
# REQUIRED in production (APP_ENV=prod refuses to start crypto without it).
COOKIES_ENCRYPTION_KEY=
